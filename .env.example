# Copier ce fichier en .env et renseigner vos valeurs locales.
# Ne jamais committer le fichier .env sur GitHub.

# Clés API Google Gemini (https://aistudio.google.com/apikey)
GOOGLE_API_KEY=
GOOGLE_API_KEY_AGENT=

# Base de données MySQL (WAMP par défaut)
DB_HOST=localhost
