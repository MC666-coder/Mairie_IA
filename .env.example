# Copier ce fichier en .env et renseigner vos valeurs locales.

# Adresse publique du site, SANS « / » final (utilisée dans les emails et redirections)
#   En local : http://localhost/Site_officiel
#   En ligne : https://www.ma-commune.fr
APP_URL=http://localhost/Site_officiel

# Base de données (valeurs par défaut de WampServer si absentes)
DB_HOST=localhost
DB_NAME=mairie_ia
DB_USER=root
DB_PASS=

# Expéditeur des emails (activation de compte, mot de passe oublié...)
MAIL_FROM=no-reply@ma-commune.fr
MAIL_FROM_NAME=Mairie de Ma Commune

# Nom de la commune affiché sur le site
NOM_COMMUNE=Ma Commune

# Coordonnées affichées sur les pages « La mairie » et « Contacts »
MAIRIE_TELEPHONE="02 51 00 00 00"
MAIRIE_EMAIL=contact@ma-commune.fr
MAIRIE_ADRESSE="Place de la Mairie, 85000 Ma Commune"


# Clés API Google Gemini (https://aistudio.google.com/apikey)
GOOGLE_API_KEY=
GOOGLE_API_KEY_AGENT=

# Fournisseur de l'IA agent : gemini (par défaut) ou claude
IA_FOURNISSEUR=gemini
GEMINI_MODELE=gemini-3.8-flash

# IA citoyen (chatbot) : mêmes réglages que l'agent par défaut. Facultatif :
# IA_FOURNISSEUR_CITOYEN=gemini
# GEMINI_MODELE_CITOYEN=gemini-3.5-flash-lite
# CLAUDE_MODELE_CITOYEN=claude-haiku-5-5

# Claude (Anthropic) — clé à créer sur https://platform.claude.com (facturation séparée
# de l'abonnement claude.ai). Modèles : claude-opus-5-5, claude-sonnet-5-5, claude-haiku-5-5
ANTHROPIC_API_KEY=
CLAUDE_MODELE=claude-opus-5-5
# Profondeur de réflexion : low | medium | high | xhigh | max
CLAUDE_EFFORT=high

# Dossier des rapports de comparaison IA (tests/ia/comparer_ia.php), HORS du projet
RAPPORTS_IA_DIR=

# Journal détaillé de l'IA agent (prompts, contexte citoyen, réponses).
# Contient des données personnelles : true UNIQUEMENT en développement local.
DEBUG_IA=false


